# =========================================================
# WAF (WhatsApp Bot Framework) - Environment Configuration
# =========================================================

# --- Database Config ---
# Prisma local SQLite database connection
DATABASE_URL="file:./storage/database.sqlite"

# --- Telegram Auto-Backup ---
# Required for sending automated SQLite backups to Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# --- Bot Configuration ---
BOT_PHONE_NUMBER="628123456789"
GROQ_API_KEY="gsk_your_groq_api_key"
