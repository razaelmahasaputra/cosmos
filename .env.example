# =========================================================
# WAF (WhatsApp Bot Framework) - Environment Configuration
# =========================================================

# --- Primary Supabase Cloud Credentials ---
# Required for restoring Baileys auth tokens & cloud app configuration.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- Optional Local Fallbacks / Managed in Supabase 'app_config' ---
# Note: When Supabase is connected, these environment variables are automatically
# fetched from the 'app_config' table in your Supabase Cloud database.
BOT_PHONE_NUMBER="628123456789"
GROQ_API_KEY="gsk_your_groq_api_key"
GITHUB_TOKEN=""
AUTO_UPDATE="false"
