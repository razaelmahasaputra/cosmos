// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model WhatsAppAuth {
  id         String   @id
  value      String
  updated_at DateTime @default(now()) @updatedAt
}

model WhitelistedGroup {
  jid String @id
}

model TelegramPrivateChat {
  chatId     String   @id
  title      String?
  inviteLink String?
  added_at   DateTime @default(now()) @updatedAt
}



model ActiveSession {
  feature    String
  jid        String
  metadata   String?
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@id([feature, jid])
}

model AiChatSession {
  jid        String   @id
  summary    String   @default("")
  updated_at DateTime @default(now()) @updatedAt
  messages   AiChatMessage[]
}

model AiChatMessage {
  id         Int      @id @default(autoincrement())
  jid        String
  session    AiChatSession @relation(fields: [jid], references: [jid], onDelete: Cascade)
  role       String
  content    String
  timestamp  DateTime @default(now())
}

model AutoDlSetting {
  jid       String
  platform  String
  enabled   Boolean @default(true)
  updated_at DateTime @default(now()) @updatedAt

  @@id([jid, platform])
}

model ScheduledDeletion {
  id         Int      @id @default(autoincrement())
  jid        String
  msgId      String
  fromMe     Boolean
  deleteAt   DateTime
  created_at DateTime @default(now())

  @@unique([jid, msgId])
}

model User {
  id             String    @id // Nomor WA / JID (contoh: 628123456789@s.whatsapp.net)
  pushName       String?   // Display Name / Nama Profil WhatsApp
  username       String?   @unique // Username baru WhatsApp (contoh: razael123)
  balance        Int       @default(5) // Starterpack 5 koin
  lastDailyClaim DateTime? 
  lastGambleAt   DateTime? // Cooldown permanen per user untuk minigame
  gamesPlayed    Int       @default(0)
  totalWins      Int       @default(0)
  totalLosses    Int       @default(0)
  // Roulette Minigame-specific statistics (new)
  rouletteRounds Int       @default(0)
  rouletteWins   Int       @default(0)
  rouletteKills  Int       @default(0)
  rouletteAfk    Int       @default(0)
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model HouseVault {
  id          Int      @id @default(1) 
  income      BigInt   @default(0) // Total koin masuk (kalah dari player)
  payout      BigInt   @default(0) // Total koin keluar (diberikan ke player)
  netProfit   BigInt   @default(0) // Keuntungan bersih bandar
  updatedAt   DateTime @updatedAt
}
